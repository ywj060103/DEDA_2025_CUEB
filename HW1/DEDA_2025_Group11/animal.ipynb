import numpy as np
import matplotlib.pyplot as plt

fig, ax = plt.subplots()

# 1. 鱼身：椭圆形
theta = np.linspace(0, 2*np.pi, 500)
x_body = 2 * np.cos(theta)
y_body = np.sin(theta)

# 2. 鱼尾巴：用三角形模拟
tail_x = np.array([-2, -3, -2])
tail_y = np.array([0.5, 0, -0.5])

# 3. 鱼鳍：用小三角形模拟
fin_x = np.array([0.5, 1.2, 0.7])
fin_y = np.array([0, 0.8, 0.4])

# 4. 画鱼身
ax.plot(x_body, y_body, 'b', linewidth=3)

# 5. 画鱼尾巴（填充三角形）
ax.fill(tail_x, tail_y, 'b')

# 6. 画鱼鳍（填充）
ax.fill(fin_x, fin_y, 'b')

# 7. 画鱼眼睛（白圈+黑点）
eye_center = (1, 0.3)
eye_white = plt.Circle(eye_center, 0.15, color='white', zorder=5)
eye_black = plt.Circle((eye_center[0]+0.05, eye_center[1]+0.05), 0.07, color='black', zorder=6)
ax.add_patch(eye_white)
ax.add_patch(eye_black)

# 8. 画布设置
ax.set_aspect('equal')
plt.axis('off')
plt.xlim([-3.5, 2.5])
plt.ylim([-1.5, 1.5])

plt.show()


